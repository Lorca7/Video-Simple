{
  "name": "video-simple",
  "productName": "Video Simple",
  "version": "1.0.0",
  "description": "A simple video editor that exports YouTube-ready video",
  "main": "src/main/main.js",
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "test": "node test/export.test.js",
    "dist": "electron-builder --mac"
  },
  "dependencies": {
    "ffmpeg-static": "^5.3.0"
  },
  "devDependencies": {
    "electron": "^45.3.1",
    "electron-builder": "^26.18.0"
  },
  "build": {
    "appId": "com.videosimple.app",
    "productName": "Video Simple",
    "files": ["src/**/*", "package.json"],
    "asarUnpack": ["node_modules/ffmpeg-static/**"],
    "directories": { "buildResources": "build" },
    "mac": {
      "category": "public.app-category.video",
      "target": ["dmg"],
      "identity": "-",
      "hardenedRuntime": false,
      "minimumSystemVersion": "12.0",
      "artifactName": "Video-Simple-${version}-${arch}.${ext}"
    }
  }
}
